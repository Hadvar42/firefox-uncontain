{
  "manifest_version": 2,
  "name": "Uncontain: typed URLs leave the container",
  "version": "1.0.3",
  "author": "Hadvar42",
  "description": "URLs you type in the address bar open in the default (no) container. Links, redirects and payment handovers stay inside the current container.",
  "browser_specific_settings": {
    "gecko": {
      "id": "uncontain@hadvar42.github.io",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "strict_min_version": "140.0"
    }
  },
  "permissions": [
    "tabs",
    "cookies",
    "webRequest",
    "webRequestBlocking",
    "webNavigation",
    "storage",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
